    "tests": [
      {
        "name": "wave HP still doubles, the lighter roster is 3/4/6, and role variety with TV/BS/SH remains",
        "ok": true
      },
      {
        "name": "soldiers emerge sequentially from MRG and later batches stay queued for seven seconds",
        "ok": true
      },
      {
        "name": "HP gates require current enemies and all queued batches; projectile floods cannot skip waves",
        "ok": true
      },
      {
        "name": "final queued soldiers prevent defeat/upload; a completed battle awards only once",
        "ok": true
      },
      {
        "name": "default fire and grenades stay horizontal in the facing direction, including guide mode",
        "ok": true
      },
      {
        "name": "real pointer projection and arcadeInput produce an oblique manual shot through Z=0",
        "ok": true
      },
      {
        "name": "aimed empty space stays empty: no snap, target selection or homing after firing",
        "ok": true
      },
      {
        "name": "real straight bullets kill on the firing line and miss targets above it; FX remain wired",
        "ok": true
      },
      {
        "name": "damage remains multiplied once by wave, with independent assist/armor reductions",
